---
/** Ledger "PostRow": date / title / tags · reading time, one ruled row. Place inside <ol class="postlist">. */
import { localeHref, type Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';
import { formatDate, readingTime, slugOf, type Post } from '@/lib/content';

interface Props {
  post: Post;
  locale: Locale;
  /** How many tags to show in the meta column. */
  tags?: number;
}

const { post, locale, tags = 1 } = Astro.props;
const t = useTranslations(locale);
const href = localeHref(locale, `/blog/${slugOf(post)}/`);
---

<li class="row">
  <a href={href} class="postrow">
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
    <span class="t">{post.data.title}</span>
    <span class="m">
      {post.data.tags.slice(0, tags).map((tag) => <span>#{tag}</span>)}
      <span>{t('blog.min', { min: readingTime(post.body, locale) })}</span>
    </span>
  </a>
</li>
