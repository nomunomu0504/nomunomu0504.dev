---
/** giscus comments, rendered only when the repository is configured via PUBLIC_GISCUS_* variables. */
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const repo = import.meta.env.PUBLIC_GISCUS_REPO;
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID;
const category = import.meta.env.PUBLIC_GISCUS_CATEGORY;
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID;
const enabled = Boolean(repo && repoId && category && categoryId);
---

{
  enabled && (
    <section aria-label={t('comments.title')} class="flex max-w-[var(--w-prose)] flex-col gap-3" data-pagefind-ignore>
      <h2 class="label m-0">COMMENTS · GISCUS</h2>
      <div class="min-h-[220px]">
        <script
          is:inline
          src="https://giscus.app/client.js"
          data-repo={repo}
          data-repo-id={repoId}
          data-category={category}
          data-category-id={categoryId}
          data-mapping="pathname"
          data-strict="1"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="top"
          data-theme="preferred_color_scheme"
          data-lang={locale}
          data-loading="lazy"
          crossorigin="anonymous"
          async
        />
      </div>
    </section>
  )
}
