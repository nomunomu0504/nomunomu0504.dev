---
import { localeHref, type Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';

interface Props {
  locale: Locale;
  /** Path of the current page in each locale. Missing locales fall back to that locale's home. */
  alternates: Partial<Record<Locale, string>>;
}

const { locale, alternates } = Astro.props;
const t = useTranslations(locale);
const items: { code: Locale; href: string }[] = [
  { code: 'ja', href: alternates.ja ?? localeHref('ja', '/') },
  { code: 'en', href: alternates.en ?? localeHref('en', '/') },
];
---

<div role="group" aria-label={t('locale.group')} class="seg">
  {
    items.map((item) => (
      <a
        href={item.href}
        hreflang={item.code}
        lang={item.code}
        aria-current={item.code === locale ? 'true' : undefined}
      >
        {item.code.toUpperCase()}
      </a>
    ))
  }
</div>
