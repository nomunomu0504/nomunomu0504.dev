---
import AdSlot from '@/components/AdSlot.astro';
import PostRow from '@/components/PostRow.astro';
import Search from '@/components/Search.astro';
import Tag from '@/components/Tag.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localeHref, type Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';
import { collectTags, groupByYear, type Post } from '@/lib/content';

interface Props {
  locale: Locale;
  posts: Post[];
}

const { locale, posts } = Astro.props;
const t = useTranslations(locale);
const groups = groupByYear(posts);
const tags = collectTags(posts);

// One list ad per six posts, at most four, placed at year boundaries (ad map).
const ADS_EVERY = 6;
const MAX_ADS = 4;
let cumulative = 0;
let placed = 0;
const sections = groups.map((group, index) => {
  cumulative += group.posts.length;
  const due = placed < MAX_ADS && index < groups.length - 1 && cumulative >= (placed + 1) * ADS_EVERY;
  if (due) placed += 1;
  return { ...group, adAfter: due };
});
const rssPath = localeHref(locale, '/rss.xml');
---

<BaseLayout title={t('blog.title')} description={t('blog.description')}>
  <section class="border-b border-rule">
    <div class="wrap flex flex-col gap-6 pt-14 pb-8">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="flex flex-col gap-2">
          <p class="label m-0">BLOG · {posts.length} POSTS</p>
          <h1 class="h1 m-0">{t('blog.title')}</h1>
          <p class="m-0 max-w-[36em] text-[15px] text-fg-2">{t('blog.description')}</p>
        </div>
        <Search locale={locale} class="max-w-[360px]" />
      </div>
      {
        tags.length > 0 && (
          <div class="flex flex-wrap items-center gap-1.5">
            <span class="label mr-2">TAGS</span>
            <Tag tag={t('blog.all')} locale={locale} href={localeHref(locale, '/blog/')} on />
            {tags.map(({ tag, count }) => (
              <Tag tag={tag} count={count} locale={locale} />
            ))}
          </div>
        )
      }
    </div>
  </section>

  <section>
    <div class="wrap main-side pt-10 pb-[72px]">
      <div class="flex min-w-0 flex-col gap-10">
        {sections.length === 0 && <p class="m-0 text-fg-2">{t('blog.empty')}</p>}
        {
          sections.map((group) => (
            <>
              <div id={`y${group.year}`} class="flex flex-col gap-3">
                <h2 class="mono m-0 flex items-center gap-3 text-fg-3">
                  <span>{group.year}</span>
                  <span aria-hidden="true" class="h-px flex-1 bg-rule" />
                  <span>{group.posts.length} POSTS</span>
                </h2>
                <ol class="postlist">
                  {group.posts.map((post) => (
                    <PostRow post={post} locale={locale} />
                  ))}
                </ol>
              </div>
              {group.adAfter && <AdSlot variant="list" />}
            </>
          ))
        }
      </div>
      <aside class="flex flex-col gap-8">
        {
          groups.length > 0 && (
            <div class="flex flex-col gap-2.5">
              <h2 class="label m-0">ARCHIVE</h2>
              <ul class="list-rule">
                {groups.map((group) => (
                  <li>
                    <a href={`#y${group.year}`}>
                      <span>{group.year}</span>
                      <span class="n">{group.posts.length}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <div class="flex flex-col gap-2.5">
          <h2 class="label m-0">RSS</h2>
          <p class="m-0 text-sm text-fg-2">
            {t('blog.rssNote')} <a href={rssPath} class="ink-link">{rssPath}</a>
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
