---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/noto-sans-jp';
import '@/styles/global.css';
import geistUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import GoogleTagManager from '@/components/GoogleTagManager.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import {
  defaultAlternates,
  localeHref,
  localeTags,
  resolveLocale,
  type Locale,
} from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';
import { site } from '@/lib/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  /** Paths of this page in each locale. Omit to assume the page exists in all locales. */
  alternates?: Partial<Record<Locale, string>>;
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
}

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const {
  title,
  description = site.description[locale],
  ogImage = site.ogImage,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
} = Astro.props;
const alternates = Astro.props.alternates ?? defaultAlternates(Astro.url.pathname, locale);

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT ?? '';
const gtmId = import.meta.env.PUBLIC_GTM_ID ?? '';
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.name}
      href={localeHref(locale, '/rss.xml')}
    />
    {
      Object.entries(alternates).map(([l, path]) => (
        <link rel="alternate" hreflang={localeTags[l as Locale]} href={new URL(path, Astro.site)} />
      ))
    }
    {alternates.ja && <link rel="alternate" hreflang="x-default" href={new URL(alternates.ja, Astro.site)} />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={localeTags[locale].replace('-', '_')} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preload" as="font" type="font/woff2" href={geistUrl} crossorigin="anonymous" />

    <script is:inline>
      // Apply the stored theme before first paint to avoid a flash of the wrong theme.
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = stored === 'light' || stored === 'dark' ? stored : prefersDark ? 'dark' : 'light';
          document.documentElement.dataset.theme = theme;
        } catch (_) {}
      })();
    </script>
    {gtmId && <GoogleTagManager id={gtmId} />}
    <slot name="head" />
  </head>
  <body class="bg-bg font-sans text-fg">
    {
      gtmId && (
        <noscript>
          <iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager" />
        </noscript>
      )
    }
    <a href="#main" class="btn sm sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-bg">
      {t('skip.main')}
    </a>
    <Header locale={locale} alternates={alternates} />
    <main id="main" class="flex flex-1 flex-col">
      <slot />
    </main>
    <Footer locale={locale} />
    <CookieConsent locale={locale} />
    {
      adsenseClient && (
        <script is:inline define:vars={{ adsenseClient }}>
          // Opt-out model: AdSense loads unless the visitor has turned ad cookies off.
          // EEA/UK opt-in is handled by Google's certified CMP, enabled in the AdSense console.
          (function () {
            function consent() {
              try {
                return localStorage.getItem('consent');
              } catch (_) {
                return null;
              }
            }
            function load() {
              if (document.querySelector('script[data-adsbygoogle]')) return;
              var s = document.createElement('script');
              s.async = true;
              s.crossOrigin = 'anonymous';
              s.dataset.adsbygoogle = '1';
              s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + adsenseClient;
              document.head.appendChild(s);
              document.querySelectorAll('ins.adsbygoogle:not([data-adsbygoogle-status])').forEach(function () {
                (window.adsbygoogle = window.adsbygoogle || []).push({});
              });
            }
            if (consent() !== 'essential') load();
            window.addEventListener('consent:changed', function (e) {
              if (e.detail === 'all') load();
            });
          })();
        </script>
      )
    }
  </body>
</html>
