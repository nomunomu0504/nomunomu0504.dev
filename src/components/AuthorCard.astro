---
import { localeHref, type Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';
import { site } from '@/lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section
  aria-label={t('author.title')}
  class="grid max-w-[var(--w-prose)] grid-cols-[56px_1fr] items-start gap-5 border border-rule-2 px-6 py-5"
  data-pagefind-ignore
>
  <span aria-hidden="true" class="block size-14 rounded-full bg-bg-3"></span>
  <div class="flex flex-col gap-2">
    <div class="flex flex-wrap items-baseline gap-3">
      <b class="text-base font-semibold">{site.name}</b>
      <span class="label">@{site.handle} · {site.role}</span>
    </div>
    <p class="m-0 text-sm leading-[1.7] text-fg-2">
      {site.bio[locale]} <a href={localeHref(locale, '/about/')} class="ink-link">About</a>
    </p>
    <nav aria-label={t('author.links')} class="mono flex gap-4 text-fg-2">
      <a href={site.social.github} rel="me noopener" class="hover:text-fg">GitHub</a>
      <a href={site.social.x} rel="me noopener" class="hover:text-fg">X</a>
      <a href={localeHref(locale, '/rss.xml')} class="hover:text-fg">RSS</a>
    </nav>
  </div>
</section>
